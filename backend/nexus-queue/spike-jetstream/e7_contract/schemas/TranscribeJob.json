{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscribeJob",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "tenant", "source_url"],
  "properties": {
    "document_id": { "type": "integer", "description": "Payload CMS document id" },
    "tenant": { "type": "string" },
    "source_url": { "type": "string", "description": "Blob claim-check (BlobStore)" },
    "lang": { "type": "string", "default": "es" },
    "diarize": { "type": "boolean", "default": false },
    "segments": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
